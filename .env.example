# ===== LLM（DeepSeek，兼容 OpenAI 协议） =====
# 不填则进入 mock 模式：工具用本地数据跑，无需任何凭证即可演示
DEEPSEEK_API_KEY=sk-填入你自己的key
# 默认留空即可 —— 未配置时会自动进入 mock 模式，用内置示例数据跑通全部工具

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
TEMPERATURE=0

# ===== 企业微信机器人（日报/告警推送，可选） =====
# 配置后 report/monitor 工具会真实 POST 到企微群机器人；否则降级为本地日志
WECHAT_WEBHOOK=

# ===== 百度网盘备份（可选） =====
# true 时 backup_data 会模拟上传网盘（异地容灾）
BAIDU_NETDISK_ENABLED=false

LOG_LEVEL=INFO
